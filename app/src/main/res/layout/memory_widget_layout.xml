<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/text_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentBottom="true">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Our Special Moment"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/widget_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap to enter our shared heart space"
            android:textColor="#FEE2E2"
            android:textSize="11sp"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_heart"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:src="@android:drawable/star_on" />

    <TextView
        android:id="@+id/widget_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentLeft="true"
        android:text="♥ HeartSync"
        android:textColor="#FECDD3"
        android:textSize="12sp"
        android:textStyle="italic|bold" />

</RelativeLayout>
